# Database — a local SQLite file (VPS / Docker / your PC) …
DATABASE_URL=file:./data/niftymeter.db
# … or Turso for serverless hosts (Vercel, Netlify, Cloudflare):
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=eyJ...

# Public address of the site (used in emails, sitemap, canonical). Leave empty to auto-detect.
SITE_URL=
# Time zone for dates and the offer countdown (default Asia/Kolkata)
APP_TZ=Asia/Kolkata
# Set to 1 if the site is behind Cloudflare / a reverse proxy, so the real visitor IP is used
TRUST_PROXY=0
